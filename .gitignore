# Ignore everything by default
*

# ── Allow logo / brand images ─────────────────
!logo.png
!square-logo.png

# ── Allow project configuration ──────────────────
!.gitignore
!.gitattributes
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.build.json

# ── Allow Storybook config ───────────────────────
!.storybook/
!.storybook/**

# ── Allow source code ────────────────────────────
!src/
!src/**

# ── Allow repo scripts ───────────────────────────
!scripts/
!scripts/**

# ── Allow design tokens ──────────────────────────
!design-tokens/
!design-tokens/**

# ── Allow the cast-sync Figma plugin ─────────────
!cast-sync/
!cast-sync/**

# ── Allow documentation & repo files ─────────────
!README.md
!LICENSE
!CHANGELOG.md
!DESIGN-CHANGELOG.md
!CLAUDE.md
!CONTRIBUTING.md
!SECURITY.md

# ── Allow agent skills (shipped in the npm package) ─
!skills/
!skills/**

# ── Allow CI/CD config ───────────────────────────
!.github/
!.github/**

# ── Allow the docs site (GitHub Pages) ───────
# node_modules/ and dist/ are re-ignored globally below, so the broad include
# here tracks the source + config but not build output or installed deps.
!site/
!site/**

# ── Re-ignore things that should never be tracked ─
# (catches anything accidentally un-ignored above)
.DS_Store
*.log
*.env
*.env.*
*.local
node_modules/

# ── Re-ignore build artifacts ─────────────────────
dist/
src/tokens/generated/
storybook-static/

# FUSE mount shadow files (left when a mounted file is edited in place)
.fuse_hidden*
